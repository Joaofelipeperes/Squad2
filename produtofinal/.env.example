# Copie para .env e ajuste. Nunca versione o .env.
# dev | homologacao | producao. Fora de dev a API NÃO inicia com GDA_SECRET_KEY de exemplo ou
# com menos de 32 bytes, nem sem GDA_ENCRYPTION_KEY.
GDA_ENVIRONMENT=dev
GDA_DATABASE_URL=postgresql+psycopg://gda:gda@db:5432/gda
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
GDA_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
# Gere com: docker compose run --rm api python -m app.cli gerar-chave
GDA_ENCRYPTION_KEY=
GDA_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# CKAN — leitura (API pública). Vazio = escolhido pelo GDA_ENVIRONMENT (ADR-0024):
#   producao            → https://dadosabertos.go.gov.br (portal oficial)
#   homologacao e dev   → http://ckansquad2-ckan-1:5000 (CKAN local da raiz, em Docker; suba com
#                         docker-compose.ckan-local.yml para a API entrar na rede dele)
# Preencha só para forçar outro: ex. http://localhost:5000 rodando a API fora do Docker.
GDA_CKAN_BASE_URL=
GDA_COLETA_CRON=0 3 * * *
# CKAN — auditoria (rastreabilidade, ADR-0009): token de API de um usuário EDITOR das
# organizações, lido pela extensão ckanext-dsaudit. Vazio = rastreabilidade não sincroniza.
GDA_CKAN_AUDITORIA_API_TOKEN=
# CKAN de onde a auditoria/diff é lida. O histórico do dsaudit só existe onde as edições ocorrem
# (o portal oficial), então a auditoria segue nele mesmo em dev/homologacao — que leem o Docker
# local para o inventário. Sem isso, o diff da tela de rastreabilidade não aparece.
# Vazio = https://dadosabertos.go.gov.br (portal oficial).
GDA_CKAN_AUDITORIA_BASE_URL=

# CKAN — escrita (US26). Só habilitar após autorização formal CGE-GO/SECTI (PBI-95).
GDA_CKAN_WRITE_ENABLED=false
GDA_CKAN_WRITE_BASE_URL=
GDA_CKAN_WRITE_API_TOKEN=

# IA — decisão da CGE-GO; manter false salvo determinação formal.
GDA_IA_PERMITIR_EXTERNO_PARA_SENSIVEL=false

# LGPD — anonimização (US26). Pasta FORA do banco para a cópia do original e a prévia
# (no Docker, volume lgpd_arquivos em /app/dados_lgpd). Sal do operador "hash" (vazio = secret_key).
GDA_LGPD_ARQUIVOS_DIR=
GDA_LGPD_SAL_HASH=
