# Copie para .env e ajuste. Nunca versione o .env.
GDA_ENVIRONMENT=dev
GDA_DATABASE_URL=postgresql+psycopg://gda:gda@db:5432/gda
GDA_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
# Gere com: docker compose run --rm api python -m app.cli gerar-chave
GDA_ENCRYPTION_KEY=
GDA_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# CKAN — leitura (API pública). Para desenvolvimento, aponte para o CKAN local (PBI-03).
GDA_CKAN_BASE_URL=https://dadosabertos.go.gov.br
GDA_COLETA_CRON=0 3 * * *

# CKAN — escrita (US26). Só habilitar após autorização formal CGE-GO/SECTI (PBI-95).
GDA_CKAN_WRITE_ENABLED=false
GDA_CKAN_WRITE_BASE_URL=
GDA_CKAN_WRITE_API_TOKEN=

# IA — decisão da CGE-GO; manter false salvo determinação formal.
GDA_IA_PERMITIR_EXTERNO_PARA_SENSIVEL=false
